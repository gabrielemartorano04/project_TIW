<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Parametri DB -->
    <context-param>
        <param-name>dbDriver</param-name>
        <param-value>com.mysql.cj.jdbc.Driver</param-value>
    </context-param>

    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/playlistdb?serverTimezone=UTC</param-value>
    </context-param>

    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>

    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>1a2b3c4d</param-value>
    </context-param>
    
    <context-param>
	    <param-name>basePath</param-name>
	    <param-value>/Users/gabriele/Desktop/uni/3 anno/2 semestre/TECNOLOGIE INFORMATICHE PER IL WEB/</param-value>
	</context-param>

    <!-- Servlet Login -->

    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>
    
    <!-- Gestione errori HTTP standard -->
    <error-page>
        <error-code>400</error-code>
        <location>/errorPage.html</location>
    </error-page>
    <error-page>
        <error-code>401</error-code>
        <location>/errorPage.html</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/errorPage.html</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/errorPage.html</location>
    </error-page>
    <error-page>
	    <error-code>405</error-code>
	    <location>/errorPage.html</location>
	</error-page>
	<error-page>
	    <error-code>408</error-code>
	    <location>/errorPage.html</location>
	</error-page>
	<error-page>
	    <error-code>429</error-code>
	    <location>/errorPage.html</location>
	</error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/errorPage.html</location>
    </error-page>
    <error-page>
	    <error-code>503</error-code>
	    <location>/errorPage.html</location>
	</error-page>
</web-app>